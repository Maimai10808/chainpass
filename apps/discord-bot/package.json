{
  "name": "@chainpass/discord-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Experimental ChainPass Discord bot scaffold",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/index.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "register:commands": "node --env-file-if-exists=.env --import tsx src/register-commands.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings src"
  },
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "discord.js": "^14.27.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "oxlint": "^1.58.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
