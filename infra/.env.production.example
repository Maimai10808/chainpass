# Public origin and HTTP listener. Use the final HTTPS origin after TLS is configured.
PUBLIC_URL=https://chainpass.example.com
HTTP_PORT=80
IMAGE_TAG=local

# PostgreSQL is reachable only on the Compose backend network.
POSTGRES_USER=chainpass
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=chainpass
DATABASE_URL=postgresql://chainpass:replace-with-a-strong-password@postgres:5432/chainpass

# Better Auth and QR signing secrets must be generated independently.
BETTER_AUTH_SECRET=replace-with-at-least-32-random-bytes
QR_VERIFICATION_SECRET=replace-with-at-least-32-random-bytes

# Ethereum Sepolia runtime.
CHAIN_ID=11155111
CHAIN_RPC_URL=https://your-sepolia-rpc.example
CHAINPASS_CONTRACT_ADDRESS=0xbA3e9bCbe448E928c5e71f4bE6415E7e0e3E5ABb
DEPLOYER_PRIVATE_KEY=replace-with-the-server-only-issuer-private-key

# Public browser configuration. Reown Project ID is not a server secret.
NEXT_PUBLIC_REOWN_PROJECT_ID=replace-with-reown-project-id
