{
  "name": "chainpass",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "turbo dev --filter=web --filter=api --filter=mobile --filter='./packages/*'",
    "build": "turbo build --filter=web --filter=api --filter=mobile --filter='./packages/*'",
    "lint": "turbo lint --filter=web --filter=api --filter=mobile --filter='./packages/*'",
    "typecheck": "turbo typecheck --filter=web --filter=api --filter=mobile --filter='./packages/*'",
    "test": "node --test scripts/workspace-boundaries.test.mjs && turbo test --filter=web --filter=api --filter=mobile --filter='./packages/*'",
    "build:all": "turbo build --concurrency=2",
    "check:all": "turbo lint typecheck test build --concurrency=2",
    "check:platforms": "turbo lint typecheck build --filter=@chainpass/telegram-mini --filter=@chainpass/telegram-bot --filter=@chainpass/extension --filter=@chainpass/discord-bot --filter=@chainpass/wechat-mini --concurrency=2",
    "web3:sync-abi": "node scripts/sync-chainpass-abi.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.6.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.6.0",
  "type": "module",
  "devDependencies": {
    "prettier": "^3.9.9",
    "turbo": "^2.11.5",
    "typescript": "^7.0.2"
  },
  "private": true
}
