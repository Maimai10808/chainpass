{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "dist/**", ".output/**"],
      "env": [
        "NEXT_PUBLIC_API_URL",
        "NEXT_PUBLIC_AUTH_URL",
        "NEXT_PUBLIC_APP_URL",
        "NEXT_PUBLIC_CHAIN_ID",
        "NEXT_PUBLIC_CHAINPASS_CONTRACT_ADDRESS",
        "NEXT_PUBLIC_REOWN_PROJECT_ID"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "@chainpass/extension#typecheck": {
      "cache": false
    },
    "test": {
      "dependsOn": ["^test"],
      "env": ["DATABASE_URL"]
    }
  }
}
